{
  "scanMs": 300,
  "strictBeginsOnly": true,
  "autoRollMs": 0,
  "turnRecognition": {
    "enabled": false,
    "strategy": "color-sample",
    "minMatches": 1,
    "samples": [
      {
        "name": "action-button",
        "xPct": 0.5,
        "yPct": 0.9,
        "color": "#fca400",
        "tolerance": 40
      }
    ],
    "cacheMs": 150,
    "triggerOnVisibilityChange": false,
    "logOnSkip": true
  },
  "colorTierRules": {
    "enabled": true,
    "tiers": {
      "red": { "maxBigBlind": 0.25 },
      "gold": { "maxBigBlind": 5 },
      "platinum": { "maxBigBlind": 10 },
      "diamond": { "maxBigBlind": 20 }
    }
  },
  "overlays": {
    "basePctSmall": 0.08,
    "basePctLarge": 0.12,
    "minW": 64,
    "minH": 48,
    "rememberDefaultOnDrag": true,
    "stakesEnabled": true,
    "clockEnabled": true,
    "anchor": {
      "xPct": 0.37,
      "yPct": 0.85
    },
    "position": {
      "mode": "anchor",
      "edge": "top-right",
      "padX": 24,
      "padY": 24
    }
  },
  "excludeTitlePrefixes": [
    "HH",
    "Hand History",
    "History",
    "Lobby",
    "Cashier",
    "Settings",
    "Options",
    "Replayer",
    "Replay",
    "Observer",
    "Videos",
    "File Explorer",
    "Explorer",
    "This PC",
    "Documents",
    "Downloads",
    "Pictures",
    "Desktop",
    "Computer",
    "Browser",
    "http",
    "https",
    "Google Chrome",
    "Chrome"
  ],
  "matchers": [
    {
      "name": "GGPoker",
      "titlePrefixes": [
        "Rush & Cash",
        "[#] Rush & Cash",
        "[#] NLH",
        "[#] PLO",
        "NLH",
        "PLO"
      ],
      "titleKeywords": ["Rush", "Cash", "NLH", "PLO"],
      "classIncludes": [
        "GGPoker",
        "GGNetwork"
      ]
    }
  ],
  "quietMode": false
}
